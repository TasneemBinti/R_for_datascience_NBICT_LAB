setwd("D:/Repositories/R_for_datascience_NBICT_LAB/D-38")
#one way Anova
#Importing the dataset
plantgrowth= PlantGrowth
#Importing the deplyr library
library(dplyr)
stats=plantgrowth%>%
group_by(group)%>%
summarise(
mean=mean(weight),
sd=sd(weight),
se=sd(weight)/sqrt(n()))
print(stats)
ggline(PlantGrowth,
x="group",
y="weight",
add=c("mean_se","jitter"))
ggline(PlantGrowth,
x="group",
y="weight",
add=c("mean_se","jitter"))
boxplot(weight ~ group, data = PlantGrowth, main = "PlantGrowth data",
ylab = "Dried weight of plants", col = "lightgray",
notch = TRUE, varwidth = TRUE)
boxplot(weight ~ group, data = PlantGrowth, main = "PlantGrowth data",
ylab = "Dried weight of plants", col = "lightgray")
library(ggpubr)
ggline(PlantGrowth,
x="group",
y="weight",
add=c("mean_se","jitter"))
summary(anova)
#Running one way Anova
anova=aov(weight~ group,data=plantgrowth)
# Tukey test: post hoc
TukeyHSD(anova)
View(plantgrowth)
#Homogeneity of variances
plot(anova,1)
library(car)
leveneTest(weight~group,dta=PlantGrowth)
leveneTest(weight~group,data=PlantGrowth)
#Anovatest with no assumption of equal variances
oneway.test((weight~group,data=PlantGrowth))
#Anovatest with no assumption of equal variances
oneway.test((weight~group,data=PlantGrowth)
#Anovatest with no assumption of equal variances
oneway.test(weight~group,data=PlantGrowth)
pairwise.t.test(PlantGrowth$weight,PlantGrowth$group,
p.adjust.method = "BH",pool.sd = FALSE)
#Checking for normal distribution
plot(anova,2)
#Extracting Residuals
aov_res=residuals(object=anova)
aov
aov_res
shapiro.test(aov_res)
