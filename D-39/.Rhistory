library(tidyverse)
#importing the dataset
d=read.csv("cropdata.csv")
View(d)
#Descriptive analysis
summs=d%>%
group_by(fert,irr)%>%
summarise(mean=mean(y),se=sd(y)/sqrt(n()),.groups = "drop")
view(summs)
#Quick viualization of summary
ggplot(summs,aes(irr,mean,group=(fert))+geom_line()
+geom_line()
+geom_line()+
geom_point(size=2)+
geom_errorbar(aes(ymin=mean-se,ymax=mean+se),width=0.2)
#Quick viualization of summary
library(ggplot2)
+geom_line()+
geom_point(size=2)+
geom_errorbar(aes(ymin=mean-se,ymax=mean+se),width=0.2)
+geom_line()+
geom_point(size=2)+
geom_errorbar(aes(ymin=mean-se,ymax=mean+se),width=0.2)+
facet_wrap(~fert)
+geom_line()+
geom_point(size=2)+
geom_errorbar(aes(ymin=mean-se,ymax=mean+se),width=0.2)+
facet_wrap(~fert)
facet_wrap(~fert,nrow=1)
#Quick viualization of summary
library(ggplot2)
facet_wrap(~fert,nrow=1)
ggplot(summs, aes(irr, mean, group = fert))+
geom_line() +
geom_point(size = 2) +
geom_errorbar(aes(ymin=mean-se, ymax=mean+se), width = .2)+
facet_wrap(~fert, nrow = 1) +
labs(x="Irrigation", y="Mean yield",
title="Interaction of Fertilizer x Irrigation") +
theme_classic(base_size = 12)
