setwd("D:/Repositories/R_for_datascience_NBICT_LAB/D-47")
dataset=read.csv("Salary_Data.csv")
library(caTools)
set.seed(123)
split=sample.split(dataset$Salary,SplitRatio = 2/3)
split
training_set=subset(dataset,split==TRUE)
test_set=subset(dataset,split==FALSE)
regressor=lm(formula=Salary~YearsExperience,data = training_set)
#checking the summary of the model
summary(regressor)
ypred=predict(regressor,newdata = test_set)
ypred
View(test_set)
ggplot()+geom_point(aes(x=training_set$YearsExperience,y=training_set$Salary))
#visualizing the training set results
library(ggplot2)
ggplot()+geom_point(aes(x=training_set$YearsExperience,y=training_set$Salary))
ggplot()+geom_point(aes(x=training_set$YearsExperience,y=training_set$Salary),
colour="red")
ggplot()+geom_point(aes(x=training_set$YearsExperience,y=training_set$Salary),
colour="red")+geom_point(aes(x=training_set$YearsExperience,y=y_pred),
colou="blue")
ggplot()+geom_point(aes(x=training_set$YearsExperience,y=training_set$Salary),
colour="red")+geom_point(aes(x=training_set$YearsExperience,y=y_pred),
colour="blue")
